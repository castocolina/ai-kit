{
  "dir_mode": "700",
  "done_line": "AIKIT-HOST-DONE <token> rc=<rc>",
  "file_mode": "600",
  "files": {
    "env": "env",
    "err": "err",
    "launcher": "launch.sh",
    "out": "out",
    "pid": "pid",
    "prompt": "prompt",
    "rc": "rc",
    "run": "run.json"
  },
  "herdr_verbs": ["tab create", "pane run", "tab close"],
  "label": {
    "max_length": 63,
    "pattern": "^aikit:(review|execute):[A-Za-z0-9][A-Za-z0-9-]{0,31}:[0-9a-f]{12}$",
    "prefix": "aikit"
  },
  "rc_pattern": "^(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9]|SIG[A-Z0-9]{2,8})$",
  "run_dir": "<state home>/ai-kit/spec/host/<token>",
  "run_record_fields": ["checkout_root", "created_ms", "host_name", "label", "launcher_pgid", "launcher_pid", "launcher_start", "pane_id", "role", "runner_pid", "runner_start", "runtime", "tab_id", "token", "version"],
  "token_pattern": "^[0-9a-f]{12}$",
  "typed_line": "sh <launcher path>",
  "verdict": "rc"
}
