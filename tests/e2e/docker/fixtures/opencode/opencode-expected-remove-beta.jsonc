{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "alpha-router": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://alpha.invalid/v1",
        "apiKey": "alpha-DO-NOT-PRINT-key"
      },
      "models": {
        "beta-router": {
          "name": "nested-decoy"
        }
      }
    },
    // leftover { retired } unmatched " quote
     /* keep { this } comment */
    // decoy separator , between last two
    "gamma-router": {
       "npm": "@ai-sdk/openai-compatible",
       "options": {
          "baseURL": "https://gamma.invalid/v1",
          "apiKey": "gamma-DO-NOT-PRINT-key"
       }
    }
  } /* after provider { brace } */,
  "model": "alpha-router/default"
}
