{
  "model_profile": "balanced",
  "commit_docs": true,
  "parallelization": true,
  "search_gitignored": false,
  "brave_search": false,
  "firecrawl": false,
  "exa_search": false,
  "git": {
    "branching_strategy": "none",
    "create_tag": true,
    "phase_branch_template": "gsd/phase-{phase}-{slug}",
    "milestone_branch_template": "gsd/{milestone}-{slug}",
    "quick_branch_template": null
  },
  "workflow": {
    "research": true,
    "plan_check": true,
    "verifier": true,
    "nyquist_validation": true,
    "auto_advance": false,
    "node_repair": true,
    "node_repair_budget": 2,
    "ui_phase": true,
    "ui_safety_gate": true,
    "ai_integration_phase": true,
    "tdd_mode": false,
    "human_verify_mode": "end-of-phase",
    "text_mode": false,
    "research_before_questions": false,
    "discuss_mode": "discuss",
    "skip_discuss": false,
    "code_review": true,
    "code_review_depth": "standard",
    "code_review_command": null,
    "pattern_mapper": true,
    "plan_bounce": false,
    "plan_bounce_script": null,
    "plan_bounce_passes": 2,
    "auto_prune_state": false,
    "post_planning_gaps": true,
    "security_enforcement": true,
    "security_asvs_level": 1,
    "security_block_on": "high",
    "cross_ai_execution": false,
    "cross_ai_command": "node .planning/scripts/cross-ai.mjs",
    "cross_ai_timeout": 1800,
    "plan_review_convergence": true,
    "_auto_chain_active": false
  },
  "review": {
    "reviewer_instances": {
      "referee-one": {
        "cli": "opencode",
        "model": "router-env/my-referee-one"
      },
      "referee-two": {
        "cli": "opencode",
        "model": "router-env/my-referee-two"
      },
      "referee-three": {
        "cli": "opencode",
        "model": "router-env/my-referee-three"
      }
    },
    "default_reviewers": [
      "referee-one",
      "referee-two",
      "referee-three"
    ],
    "timeouts": {
      "opencode": 1800
    },
    "effort": {
      "opencode": "inherit"
    },
    "parallel_lanes": true
  },
  "ship": {
    "pr_body_sections": []
  },
  "hooks": {
    "context_warnings": true
  },
  "project_code": null,
  "phase_naming": "sequential",
  "agent_skills": {
    "gsd-assumptions-analyzer": [
      "skills/jev-fast-decision"
    ],
    "gsd-advisor-researcher": [
      "skills/jev-fast-decision"
    ],
    "gsd-ai-researcher": [
      "skills/jev-fast-decision"
    ],
    "gsd-codebase-mapper": [
      "skills/jev-fast-decision"
    ],
    "gsd-code-fixer": [
      "skills/jev-fast-decision"
    ],
    "gsd-code-reviewer": [
      "skills/jev-fast-decision"
    ],
    "gsd-debugger": [
      "skills/jev-fast-decision"
    ],
    "gsd-debug-session-manager": [
      "skills/jev-fast-decision"
    ],
    "gsd-doc-synthesizer": [
      "skills/jev-fast-decision"
    ],
    "gsd-doc-verifier": [
      "skills/jev-fast-decision"
    ],
    "gsd-doc-writer": [
      "skills/jev-fast-decision"
    ],
    "gsd-domain-researcher": [
      "skills/jev-fast-decision"
    ],
    "gsd-eval-auditor": [
      "skills/jev-fast-decision"
    ],
    "gsd-eval-planner": [
      "skills/jev-fast-decision"
    ],
    "gsd-executor": [
      "skills/jev-fast-decision"
    ],
    "gsd-framework-selector": [
      "skills/jev-fast-decision"
    ],
    "gsd-integration-checker": [
      "skills/jev-fast-decision"
    ],
    "gsd-intel-updater": [
      "skills/jev-fast-decision"
    ],
    "gsd-mempalace-curator": [
      "skills/jev-fast-decision"
    ],
    "gsd-nyquist-auditor": [
      "skills/jev-fast-decision"
    ],
    "gsd-pattern-mapper": [
      "skills/jev-fast-decision"
    ],
    "gsd-phase-researcher": [
      "skills/jev-fast-decision"
    ],
    "gsd-plan-checker": [
      "skills/jev-fast-decision"
    ],
    "gsd-planner": [
      "skills/jev-fast-decision"
    ],
    "gsd-project-researcher": [
      "skills/jev-fast-decision"
    ],
    "gsd-research-synthesizer": [
      "skills/jev-fast-decision"
    ],
    "gsd-roadmapper": [
      "skills/jev-fast-decision"
    ],
    "gsd-security-auditor": [
      "skills/jev-fast-decision"
    ],
    "gsd-ui-auditor": [
      "skills/jev-fast-decision"
    ],
    "gsd-ui-checker": [
      "skills/jev-fast-decision"
    ],
    "gsd-ui-researcher": [
      "skills/jev-fast-decision"
    ],
    "gsd-verifier": [
      "skills/jev-fast-decision"
    ]
  },
  "claude_md_path": "./AGENTS.md",
  "plan_review": {
    "source_grounding": true,
    "source_grounding_authority": "grep"
  },
  "effort": {
    "default": "high",
    "agent_overrides": {
      "gsd-planner": "xhigh",
      "gsd-code-reviewer": "high",
      "gsd-executor": "high",
      "gsd-roadmapper": "xhigh"
    },
    "routing_tier_defaults": {
      "heavy": "high",
      "light": "low",
      "standard": "medium"
    }
  },
  "model_overrides": {
    "gsd-planner": "opus",
    "gsd-code-reviewer": "opus",
    "gsd-plan-checker": "sonnet",
    "gsd-roadmapper": "opus",
    "gsd-executor": "haiku"
  },
  "runtime": "claude",
  "resolve_model_ids": false,
  "dynamic_routing": {
    "enabled": true,
    "tier_models": {
      "light": "haiku",
      "standard": "sonnet",
      "heavy": "opus"
    },
    "escalate_on_failure": true,
    "max_escalations": 1
  },
  "graphify": {
    "enabled": true,
    "auto_update": true
  }
}
