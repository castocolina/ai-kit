{
  "id": "ai-kit-commit-fold",
  "role": "feature",
  "version": "0.2.0",
  "title": "ai-kit commit fold",
  "description": "Folds each finished plan of a phase into logical-feature commits after every wave.",
  "tier": "full",
  "requires": [],
  "engines": {"gsd": ">=1.6.0"},
  "runtimeCompat": {"supported": ["*"], "unsupported": []},
  "skills": [],
  "agents": [],
  "hooks": [],
  "config": {},
  "commands": [
    {"family": "ai-kit-fold", "module": "ai-kit-fold.cjs", "router": "route"}
  ],
  "steps": [
    {
      "point": "discuss:pre",
      "ref": {"command": "ai-kit-fold start"},
      "produces": [],
      "consumes": [],
      "onError": "skip"
    },
    {
      "point": "execute:wave:post",
      "ref": {"command": "ai-kit-fold checkpoint"},
      "produces": [],
      "consumes": [],
      "onError": "skip"
    }
  ],
  "contributions": [],
  "gates": [
    {
      "point": "ship:pre",
      "blocking": true,
      "onError": "halt",
      "check": {
        "predicate": {
          "kind": "command-exit-zero",
          "command": "node .claude/gsd-core/bin/gsd-tools.cjs ai-kit-fold ship --phase ${PHASE_NUMBER}",
          "timeout": 20
        }
      }
    }
  ]
}
